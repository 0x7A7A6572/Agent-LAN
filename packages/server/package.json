{
  "name": "@mac/server",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');['worker.sh','probe.sh','bell.sh','hook-ask.mjs'].forEach(f=>fs.copyFileSync('src/'+f,'dist/'+f));fs.cpSync('src/logos','dist/logos',{recursive:true});fs.cpSync('../../web-console/dist','dist/web',{recursive:true});fs.copyFileSync('../../docs/agent-onboarding.md','dist/install.md')\"",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@mac/sdk": "workspace:*"
  }
}
